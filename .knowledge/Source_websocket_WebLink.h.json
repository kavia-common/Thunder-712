{"is_source_file": true, "format": "C++ header", "description": "This file defines a template class `WebLinkType` within the `WPEFramework::Web` namespace. It implements a generic WebLink mechanism managing serialization, deserialization, transmission (sending), and reception of inbound and outbound web objects, including channel state management and activity tracking. It includes nested classes for serialization/deserialization implementations and handler types, enabling extensibility and customization for web communication channels.", "external_files": ["Module.h", "WebRequest.h", "WebResponse.h", "WebSerializer.h", "WebTransform.h"], "external_methods": ["Core::ProxyType<OUTBOUND>::Add", "Core::ProxyType<OUTBOUND>::Count", "Core::ProxyType<OUTBOUND>::Release", "Core::ProxyType<OUTBOUND>::operator*", "Core::CriticalSection::Lock", "Core::CriticalSection::Unlock", "Core::ProxyList<OUTBOUND>::Add", "Core::ProxyList<OUTBOUND>::Remove", "Core::ProxyList<OUTBOUND>::Count", "Core::ProxyList<OUTBOUND>::operator[]", "ASSERT", "DEBUG_VARIABLE"], "published": ["WebLinkType"], "classes": [{"name": "WebLinkType", "description": "A template class that manages a web communication link, providing mechanisms for serialization, deserialization, handling channel states, activity, and data transfer for inbound and outbound message types."}, {"name": "SerializerImpl", "description": "Handles the serialization of outbound messages, managing a queue and triggering transmission upon submission."}, {"name": "DeserializerImpl", "description": "Handles the deserialization of inbound messages, managing input buffers and invoking appropriate callbacks."}, {"name": "HandlerType", "description": "A helper class that wraps link handling functionality, tracking activity and forwarding send/receive/state change events."}], "methods": [{"name": "bool LinkBody(typename INBOUND::BaseElement & element)", "description": "Notification that a partial inbound request has been received, allowing to attach